{
  "manifest_version": 3,
  "name": "Telegram 快取守衛 (Cache Guard)",
  "version": "1.1.0",
  "description": "自動監控並動態限制 Telegram 網頁版快取容量，徹底清除 30 萬零碎串流檔案，防止 Chrome 卡死。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Telegram 快取守衛"
  },
  "permissions": [
    "storage",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
